# Only project source and release documentation belong in this repository.
# Keep unrelated files in this workspace out of future `git add .` operations.
/*
!/.gitignore
!/Package.swift
!/Package.resolved
!/README.md
!/LICENSE
!/BACKLOG.md
!/PRODUCTION.md
!/LOCAL_SIGNING.md
!/UPDATES.md
!/COMPATIBILITY.md
!/THIRD_PARTY.md
!/SECURITY.md
!/PRIVACY.md
!/AUDIT.md
!/RELEASE_NOTES.md
!/Sources/
!/Tests/
!/scripts/
!/Resources/
!/Vendor/

.build/
dist/
.DS_Store
.swiftpm/
__pycache__/
*.pyc
.env
.env.*
*.p12
*.pfx
*.pem
*.key
*.keychain
*.keychain-db
node_modules/
/Vendor/**/.*
